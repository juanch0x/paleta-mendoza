---
import type { RecordFigures } from "@/domain/player-stats";

type Props = {
  title: string;
  figuras: RecordFigures;
  headingLevel?: 3 | 4;
};

const { title, figuras, headingLevel = 4 } = Astro.props;
const Heading = headingLevel === 3 ? "h3" : "h4";
const rows = [
  { label: "Títulos", value: figuras.titulos },
  { label: "Subcampeonatos", value: figuras.subcampeonatos },
  { label: "Finales jugadas", value: figuras.finales },
  { label: "Semifinales jugadas", value: figuras.semifinales },
  { label: "Partidos ganados", value: figuras.partidosGanados },
  { label: "Partidos perdidos", value: figuras.partidosPerdidos },
  { label: "Sets ganados", value: figuras.setsGanados },
  { label: "Sets perdidos", value: figuras.setsPerdidos },
  {
    label: "Compañeros distintos con los que ganó títulos",
    value: figuras.companerosCampeones,
  },
];
---

<div class="border-border rounded-xl border p-5">
  <Heading class="text-xl font-bold">{title}</Heading>
  <dl class="divide-border mt-3 divide-y">
    {
      rows.map(row => (
        <div class="flex items-baseline justify-between gap-4 py-2.5">
          <dt class="text-lg">{row.label}</dt>
          <dd class="text-2xl font-bold tabular-nums">{row.value}</dd>
        </div>
      ))
    }
  </dl>
</div>
