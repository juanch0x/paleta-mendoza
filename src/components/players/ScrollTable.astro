---
type Props = {
  /** Id of the heading that names the table. */
  labelledby: string;
};

const { labelledby } = Astro.props;
---

<p class="text-foreground/70 mt-2 text-base sm:hidden">
  Deslizá la tabla hacia los costados para ver todas las columnas.
</p>
<div
  class="tabla-scroll border-border bg-background -mx-4 mt-4 overflow-x-auto border-y sm:mx-0 sm:rounded-xl sm:border"
  role="region"
  aria-labelledby={labelledby}
  tabindex="0"
>
  <slot />
</div>

<style is:global>
  /* A table that scrolls sideways inside a `p-4` card, with its leading
     columns sticky. Every cell gets an opaque background so scrolled figures
     don't show through; tints (the site's bg-muted/70 header, grey rows) are
     layered over the page colour because --color-muted is translucent in
     dark mode. */
  .tabla-scroll th,
  .tabla-scroll td {
    --tinte: transparent;
    background: linear-gradient(var(--tinte), var(--tinte))
      var(--color-background);
  }
  .tabla-scroll thead th,
  .tabla-scroll .separador th {
    --tinte: color-mix(in srgb, var(--color-muted) 70%, transparent);
  }
  .tabla-scroll .gris td {
    --tinte: color-mix(in srgb, var(--color-muted) 50%, transparent);
    color: color-mix(in srgb, var(--color-foreground) 65%, transparent);
  }

  /* On phones the sticky columns stay narrow (text wraps) so the figures
     have room to scroll into view beside them. */
  .tabla-scroll .col-puesto {
    position: sticky;
    left: 0;
    width: 4rem;
    min-width: 4rem;
    padding-inline: 0.5rem 0.25rem;
  }
  .tabla-scroll .col-jugador {
    position: sticky;
    left: 4rem;
    min-width: 8rem;
    max-width: 8.5rem;
    padding-inline: 0.5rem 0.75rem;
    text-align: left;
    box-shadow: inset -1px 0 0 var(--color-border);
  }
  /* A single sticky label column. */
  .tabla-scroll .col-fija {
    position: sticky;
    left: 0;
    min-width: 9rem;
    max-width: 10rem;
    padding-inline: 0.75rem;
    text-align: left;
    box-shadow: inset -1px 0 0 var(--color-border);
  }
  @media (min-width: 640px) {
    .tabla-scroll .col-puesto {
      width: 6rem;
      min-width: 6rem;
      padding-inline: 1rem;
    }
    .tabla-scroll .col-jugador {
      left: 6rem;
      min-width: 13rem;
      max-width: none;
      padding-inline: 1rem;
    }
    .tabla-scroll .col-fija {
      min-width: 16rem;
      max-width: 18rem;
      padding-inline: 1rem;
    }
  }
</style>
