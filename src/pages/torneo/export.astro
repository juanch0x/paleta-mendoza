---
import Layout from "@/layouts/Layout.astro";
import TournamentExport from "@/components/tournament/TournamentExport";
import { activeTournamentConfig } from "@/data/active-tournament-config";
import { hasActiveTournament } from "@/data/tournament-availability";

const parejasUrl = import.meta.env.PUBLIC_ACTIVE_TOURNAMENT_PAREJAS_CSV_URL;
const partidosUrl = import.meta.env.PUBLIC_ACTIVE_TOURNAMENT_PARTIDOS_CSV_URL;

if (!hasActiveTournament(undefined, activeTournamentConfig.isActive))
  return Astro.redirect("/torneos/");
---

<Layout
  title="Parte diario"
  description="Generación de partes diarios del torneo."
>
  <main id="main-content">
    <TournamentExport
      client:only="react"
      parejasUrl={parejasUrl}
      partidosUrl={partidosUrl}
    />
  </main>
</Layout>
