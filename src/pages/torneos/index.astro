---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Layout from "@/layouts/Layout.astro";
import registry from "@/data/torneos/registro.json";
---

<Layout title="Torneos anteriores" description="Resultados y posiciones de torneos cerrados.">
  <Header />
  <main id="main-content">
    <section class="pt-12 pb-16 sm:pt-16">
      <p class="text-sm font-semibold tracking-[0.2em] text-accent uppercase">Archivo</p>
      <h1 class="mt-3 max-w-3xl text-4xl leading-tight font-bold sm:text-6xl">Torneos anteriores.</h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-foreground/80">
        Resultados, posiciones y fixture de los torneos ya cerrados.
      </p>

      <div class="mt-10 space-y-4">
        {registry.map((torneo) => (
          <a
            href={`/torneos/${torneo.slug}`}
            class="block rounded-2xl border border-border bg-muted/30 p-6 transition hover:border-accent hover:shadow-md"
          >
            <p class="text-xs font-semibold tracking-[0.18em] text-accent uppercase">{torneo.fecha}</p>
            <div class="mt-2 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <h2 class="text-2xl font-bold sm:text-3xl">{torneo.nombre}</h2>
                <p class="mt-2 text-foreground/70">{torneo.alcance}</p>
              </div>
              <span class="font-semibold text-accent">Ver resultados →</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
