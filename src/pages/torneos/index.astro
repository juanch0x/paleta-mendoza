---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Layout from "@/layouts/Layout.astro";
import registry from "@/data/torneos/registro.json";
import { activeTournamentConfig } from "@/data/active-tournament-config";

const hasActiveTournament = Boolean(
  import.meta.env.PUBLIC_ACTIVE_TOURNAMENT_PAREJAS_CSV_URL &&
    import.meta.env.PUBLIC_ACTIVE_TOURNAMENT_PARTIDOS_CSV_URL
);
---

<Layout
  title="Torneos"
  description="Torneo activo, resultados y posiciones de ediciones anteriores."
>
  <Header />
  <main id="main-content">
    <section class="pt-8 pb-16 sm:pt-12">
      <h1 class="sr-only">Torneos</h1>
      {
        hasActiveTournament && (
          <a
            href="/torneo/"
            class="border-skin-line border-l-accent bg-skin-fill relative block min-h-44 overflow-hidden rounded-xl border border-l-4 p-5 transition hover:shadow-md sm:p-6"
          >
            <img
              src={activeTournamentConfig.clubLogo}
              alt=""
              aria-hidden="true"
              class="pointer-events-none absolute -right-8 -bottom-10 size-48 object-contain opacity-10 sm:-right-4 sm:-bottom-14 sm:size-56"
            />
            <div class="relative flex min-h-32 flex-col justify-between gap-6 sm:flex-row sm:items-center sm:gap-8">
              <div>
                <div class="text-accent flex items-center gap-2 text-xs font-semibold tracking-[0.18em] uppercase">
                  <span class="relative flex size-2" aria-hidden="true">
                    <span class="bg-accent absolute inline-flex size-full animate-ping rounded-full opacity-60" />
                    <span class="bg-accent relative inline-flex size-2 rounded-full" />
                  </span>
                  En curso
                </div>
                <h2 class="mt-2 text-xl font-bold sm:text-2xl">
                  {activeTournamentConfig.name}
                </h2>
              </div>
              <span class="text-accent shrink-0 font-semibold">
                Ver torneo →
              </span>
            </div>
          </a>
        )
      }

      <div class:list={["space-y-4", { "mt-4": hasActiveTournament }]}>
        {
          registry.map(torneo => (
            <a
              href={`/torneos/${torneo.slug}`}
              class="border-border bg-muted/30 hover:border-accent relative block min-h-44 overflow-hidden rounded-2xl border p-6 transition hover:shadow-md"
            >
              <img
                src={torneo.clubLogo}
                alt=""
                aria-hidden="true"
                class="pointer-events-none absolute -right-9 -bottom-12 size-52 object-contain opacity-10 sm:-right-5 sm:-bottom-16 sm:size-60"
              />
              <p class="text-accent relative text-xs font-semibold tracking-[0.18em] uppercase">
                {torneo.fecha}
              </p>
              <div class="relative mt-2 flex min-h-32 flex-col justify-between gap-6 sm:flex-row sm:items-center sm:gap-8">
                <div>
                  <h2 class="text-2xl font-bold sm:text-3xl">
                    {torneo.nombre}
                  </h2>
                </div>
                <span class="text-accent font-semibold">Ver resultados →</span>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </main>
  <Footer />
</Layout>
