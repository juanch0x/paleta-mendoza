---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import Layout from "@/layouts/Layout.astro";
import registry from "@/data/torneos/registro.json";
import { activeTournamentConfig } from "@/data/active-tournament-config";

const hasActiveTournament = Boolean(
  import.meta.env.PUBLIC_ACTIVE_TOURNAMENT_PAREJAS_CSV_URL &&
    import.meta.env.PUBLIC_ACTIVE_TOURNAMENT_PARTIDOS_CSV_URL,
);
---

<Layout title="Torneos" description="Torneo activo, resultados y posiciones de ediciones anteriores.">
  <Header />
  <main id="main-content">
    <section class="pt-8 pb-16 sm:pt-12">
      <h1 class="sr-only">Torneos</h1>
      {
        hasActiveTournament && (
          <a
            href="/torneo/"
            class="block rounded-xl border border-skin-line border-l-4 border-l-accent bg-skin-fill p-5 transition hover:shadow-md sm:p-6"
          >
            <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between sm:gap-8">
              <div>
                <div class="flex items-center gap-2 text-xs font-semibold tracking-[0.18em] text-accent uppercase">
                  <span class="relative flex size-2" aria-hidden="true">
                    <span class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-60"></span>
                    <span class="relative inline-flex size-2 rounded-full bg-accent"></span>
                  </span>
                  En curso
                </div>
                <h2 class="mt-2 text-xl font-bold sm:text-2xl">{activeTournamentConfig.name}</h2>
                <p class="mt-2 text-foreground/70">{activeTournamentConfig.description}</p>
              </div>
              <span class="shrink-0 font-semibold text-accent">Ver torneo →</span>
            </div>
          </a>
        )
      }

      <div class:list={["space-y-4", { "mt-4": hasActiveTournament }]}>
        {registry.map((torneo) => (
          <a
            href={`/torneos/${torneo.slug}`}
            class="block rounded-2xl border border-border bg-muted/30 p-6 transition hover:border-accent hover:shadow-md"
          >
            <p class="text-xs font-semibold tracking-[0.18em] text-accent uppercase">{torneo.fecha}</p>
            <div class="mt-2 flex flex-col gap-2 sm:flex-row sm:items-end sm:justify-between">
              <div>
                <h2 class="text-2xl font-bold sm:text-3xl">{torneo.nombre}</h2>
                <p class="mt-2 text-foreground/70">{torneo.alcance}</p>
              </div>
              <span class="font-semibold text-accent">Ver resultados →</span>
            </div>
          </a>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
