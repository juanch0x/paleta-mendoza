---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import ActiveTournament from "@/components/tournament/ActiveTournament";
import TournamentIdentity from "@/components/tournament/TournamentIdentity";
import Layout from "@/layouts/Layout.astro";
import registry from "@/data/torneos/registro.json";
import type { ActiveTournament as TournamentData } from "@/data/active-tournament";

type Archive = {
  slug: string;
  nombre: string;
  edition: string;
  hostClubName: string;
  clubId: "gimnasia-y-esgrima" | "regatas";
  fecha: string;
  alcance: string;
  parejas: TournamentData["parejas"];
  partidos: TournamentData["partidos"];
};

export function getStaticPaths() {
  const archives = import.meta.glob("../../data/torneos/archivos/*.json", {
    eager: true,
    import: "default",
  });

  return registry.map(entry => {
    const tournament = archives[
      `../../data/torneos/archivos/${entry.slug}.json`
    ] as Archive | undefined;
    if (!tournament)
      throw new Error(`No se encontró el histórico ${entry.slug}.`);
    return { params: { slug: entry.slug }, props: { tournament } };
  });
}

const { tournament } = Astro.props as { tournament: Archive };
const tournamentData = {
  parejas: tournament.parejas,
  partidos: tournament.partidos,
} as unknown as TournamentData;
---

<Layout
  title={tournament.nombre}
  description={`Resultados y posiciones del ${tournament.nombre}.`}
>
  <Header />
  <main id="main-content">
    <section class="pt-12 pb-16 sm:pt-16">
      <a
        href="/torneos"
        class="text-accent text-sm font-semibold hover:underline"
        >← Torneos anteriores</a
      >
      <TournamentIdentity
        eyebrow={`Torneo histórico · ${tournament.fecha}`}
        edition={tournament.edition}
        hostClubName={tournament.hostClubName}
        clubId={tournament.clubId}
        headingLevel={1}
      />
      <ActiveTournament
        client:load
        initialTournament={tournamentData}
        showHeader={false}
        showSearch={false}
      />
    </section>
  </main>
  <Footer />
</Layout>
