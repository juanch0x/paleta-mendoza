---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import Hr from "@/components/Hr.astro";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getCollection } from "astro:content";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";

const latestPosts = getSortedPosts(
  await getCollection("blog", ({ data }) => !data.draft),
).slice(0, 3);
---

<Layout>
  <Header />
  <main id="main-content">
    <section class="pt-14 pb-12 sm:pt-20">
      <p class="text-sm font-semibold tracking-[0.2em] text-accent uppercase">
        Pelota paleta en Mendoza
      </p>
      <h1 class="mt-4 max-w-3xl text-4xl leading-tight font-bold sm:text-6xl">
        Torneos, fixture y resultados en un solo lugar.
      </h1>
      <p class="mt-6 max-w-2xl text-lg leading-8">
        Consultá cuándo jugás, seguí las tablas de cada zona y enterate de las
        novedades de la Federación de Paleta de Mendoza.
      </p>
      <div class="mt-8">
        <LinkButton href="/torneo/" class="text-lg">
          Ver torneo activo <IconArrowRight class="inline-block" />
        </LinkButton>
      </div>
    </section>

    <Hr />

    <section class="py-12">
      <div class="flex items-end justify-between gap-4">
        <div>
          <p class="text-sm font-semibold tracking-[0.2em] text-accent uppercase">
            Al día
          </p>
          <h2 class="mt-2 text-2xl font-semibold tracking-wide">Novedades</h2>
        </div>
        <LinkButton href="/posts/">
          Ver noticias <IconArrowRight class="inline-block" />
        </LinkButton>
      </div>

      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {
          latestPosts.map(post => {
            const image = post.data.ogImage;
            const imageSrc = typeof image === "string" ? image : image?.src;

            return (
              <article class="group overflow-hidden rounded-xl border border-skin-line bg-skin-fill shadow-sm transition hover:-translate-y-1 hover:shadow-md">
                <a href={getPath(post.id, post.filePath)} class="block">
                  {imageSrc && (
                    <img
                      src={imageSrc}
                      alt=""
                      class="aspect-[4/3] w-full object-cover"
                      loading="lazy"
                    />
                  )}
                  <div class="p-5">
                    <time class="text-sm text-skin-base/70" datetime={post.data.pubDatetime.toISOString()}>
                      {post.data.pubDatetime.toLocaleDateString("es-AR", {
                        day: "numeric",
                        month: "long",
                        year: "numeric",
                        timeZone: "UTC",
                      })}
                    </time>
                    <h3 class="mt-2 text-xl font-semibold leading-snug group-hover:text-accent">
                      {post.data.title}
                    </h3>
                    <p class="mt-3 leading-7 text-skin-base/80">{post.data.description}</p>
                    <span class="mt-4 inline-block font-medium text-accent">
                      Leer novedad <IconArrowRight class="inline-block" />
                    </span>
                  </div>
                </a>
              </article>
            );
          })
        }
      </div>
    </section>
  </main>
  <Footer />
</Layout>
