---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import LinkButton from "@/components/LinkButton.astro";
import IconArrowRight from "@/assets/icons/IconArrowRight.svg";
import { getCollection } from "astro:content";
import getSortedPosts from "@/utils/getSortedPosts";
import { getPath } from "@/utils/getPath";
import { activeTournamentConfig } from "@/data/active-tournament-config";

const latestPosts = getSortedPosts(
  await getCollection("blog", ({ data }) => !data.draft)
).slice(0, 3);

const hasActiveTournament = Boolean(
  import.meta.env.PUBLIC_ACTIVE_TOURNAMENT_PAREJAS_CSV_URL &&
    import.meta.env.PUBLIC_ACTIVE_TOURNAMENT_PARTIDOS_CSV_URL
);
---

<Layout>
  <Header />
  <main id="main-content">
    {
      hasActiveTournament && (
        <section class="pt-8 pb-6 sm:pt-12 sm:pb-8">
          <div class="border-skin-line border-l-accent bg-skin-fill relative overflow-hidden rounded-xl border border-l-4 p-5 sm:flex sm:items-center sm:justify-between sm:gap-8 sm:p-6">
            <img
              src={activeTournamentConfig.clubLogo}
              alt=""
              aria-hidden="true"
              class="pointer-events-none absolute -right-8 -bottom-10 size-48 object-contain opacity-10 sm:-right-4 sm:-bottom-14 sm:size-56"
            />
            <div class="relative">
              <p class="text-accent text-sm font-semibold tracking-[0.2em] uppercase">
                Torneo activo
              </p>
              <h1 class="mt-2 max-w-2xl text-xl leading-tight font-bold sm:text-2xl">
                {activeTournamentConfig.name}
              </h1>
              <p class="text-skin-base/80 mt-3 max-w-xl leading-7">
                {activeTournamentConfig.description}
              </p>
            </div>
            <LinkButton href="/torneo/" class="relative mt-5 shrink-0 sm:mt-0">
              Ver torneo <IconArrowRight class="inline-block" />
            </LinkButton>
          </div>
        </section>
      )
    }

    <section
      class:list={{
        "pt-10": !hasActiveTournament,
        "py-8": hasActiveTournament,
      }}
    >
      <div class="flex items-end justify-between gap-4">
        <div>
          <p
            class="text-accent text-sm font-semibold tracking-[0.2em] uppercase"
          >
            Al día
          </p>
          <h2 class="mt-2 text-2xl font-semibold tracking-wide">Novedades</h2>
        </div>
        <LinkButton href="/posts/">
          Ver noticias <IconArrowRight class="inline-block" />
        </LinkButton>
      </div>

      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {
          latestPosts.map(post => {
            const image = post.data.ogImage;
            const imageSrc = typeof image === "string" ? image : image?.src;

            return (
              <article class="group border-skin-line bg-skin-fill overflow-hidden rounded-xl border shadow-sm transition hover:-translate-y-1 hover:shadow-md">
                <a href={getPath(post.id, post.filePath)} class="block">
                  {imageSrc && (
                    <img
                      src={imageSrc}
                      alt=""
                      class="aspect-[4/3] w-full object-cover"
                      loading="lazy"
                    />
                  )}
                  <div class="p-5">
                    <time
                      class="text-skin-base/70 text-sm"
                      datetime={post.data.pubDatetime.toISOString()}
                    >
                      {post.data.pubDatetime.toLocaleDateString("es-AR", {
                        day: "numeric",
                        month: "long",
                        year: "numeric",
                        timeZone: "UTC",
                      })}
                    </time>
                    <h3 class="group-hover:text-accent mt-2 text-xl leading-snug font-semibold">
                      {post.data.title}
                    </h3>
                    <p class="text-skin-base/80 mt-3 leading-7">
                      {post.data.description}
                    </p>
                    <span class="text-accent mt-4 inline-block font-medium">
                      Leer novedad <IconArrowRight class="inline-block" />
                    </span>
                  </div>
                </a>
              </article>
            );
          })
        }
      </div>
    </section>
  </main>
  <Footer />
</Layout>
