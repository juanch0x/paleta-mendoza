---
import Footer from "@/components/Footer.astro";
import RecordFiguresList from "@/components/players/RecordFiguresList.astro";
import Header from "@/components/Header.astro";
import Layout from "@/layouts/Layout.astro";
import {
  jsonArchivedTournamentRepository,
  jsonPlayerRepository,
} from "@/data/repositories/json";
import { buildPlayerStats, type PlayerStats } from "@/domain/player-stats";

export async function getStaticPaths() {
  const [players, tournaments] = await Promise.all([
    jsonPlayerRepository.list(),
    jsonArchivedTournamentRepository.list(),
  ]);
  return buildPlayerStats(players, tournaments).map(stats => ({
    params: { id: stats.player.id },
    props: { stats },
  }));
}

const { stats } = Astro.props as { stats: PlayerStats };
const { player, historial } = stats;
const figures = [
  { label: "Títulos", value: stats.titulos },
  { label: "Subcampeonatos", value: stats.subcampeonatos },
];
---

<Layout
  title={player.nombreOficial}
  description={`Estadísticas de ${player.nombreOficial} en los torneos finalizados.`}
>
  <Header />
  <main id="main-content">
    <section class="pt-12 pb-16 sm:pt-16">
      <p class="text-accent text-sm font-semibold tracking-[0.18em] uppercase">
        Jugador
      </p>
      <h1 class="mt-2 text-3xl font-bold sm:text-4xl">
        {player.nombreOficial}
      </h1>
      <p class="mt-3 text-base">
        Resultados de los torneos finalizados. El torneo en curso no se cuenta.
      </p>
      <dl class="mt-8 grid grid-cols-2 gap-4 sm:max-w-md">
        {
          figures.map(figure => (
            <div class="border-border rounded-xl border p-5">
              <dt class="text-lg font-semibold">{figure.label}</dt>
              <dd class="mt-2 text-4xl font-bold">{figure.value}</dd>
            </div>
          ))
        }
      </dl>
    </section>
    <section aria-labelledby="historial-titulo" class="pb-16">
      <h2 id="historial-titulo" class="text-2xl font-bold sm:text-3xl">
        Historial completo
      </h2>
      {
        historial.porAnio.length === 0 ? (
          <p class="mt-3 text-lg">
            Todavía no tiene partidos en torneos finalizados.
          </p>
        ) : (
          <div class="mt-6 grid gap-5 sm:max-w-xl">
            <RecordFiguresList
              title="Total de todos los torneos"
              figuras={historial.total}
              headingLevel={3}
            />
          </div>
        )
      }
      {
        historial.porAnio.map(year => (
          <div class="mt-10">
            <h3 class="text-2xl font-bold">Año {year.anio}</h3>
            <div class="mt-4 grid gap-5 sm:max-w-xl">
              {year.porCategoria.length > 1 && (
                <RecordFiguresList
                  title={`Total del año ${year.anio}`}
                  figuras={year.total}
                />
              )}
              {year.porCategoria.map(record => (
                <RecordFiguresList
                  title={`${year.anio} · Categoría ${record.categoria}`}
                  figuras={record.figuras}
                />
              ))}
            </div>
          </div>
        ))
      }
      {
        historial.porAnio.length > 1 && (
          <div class="mt-10">
            <h3 class="text-2xl font-bold">
              Por categoría, todos los años juntos
            </h3>
            <div class="mt-4 grid gap-5 sm:max-w-xl">
              {historial.porCategoria.map(record => (
                <RecordFiguresList
                  title={`Categoría ${record.categoria}`}
                  figuras={record.figuras}
                />
              ))}
            </div>
          </div>
        )
      }
    </section>
  </main>
  <Footer />
</Layout>
