---
import Footer from "@/components/Footer.astro";
import RecordFiguresList from "@/components/players/RecordFiguresList.astro";
import Header from "@/components/Header.astro";
import Layout from "@/layouts/Layout.astro";
import {
  jsonArchivedTournamentRepository,
  jsonPlayerRepository,
} from "@/data/repositories/json";
import { buildPlayerStats, type PlayerStats } from "@/domain/player-stats";
import { buildOfficialProfile } from "@/domain/player-stats";

export async function getStaticPaths() {
  const [players, tournaments] = await Promise.all([
    jsonPlayerRepository.list(),
    jsonArchivedTournamentRepository.list(),
  ]);
  return buildPlayerStats(players, tournaments).map(stats => ({
    params: { id: stats.player.id },
    props: { stats },
  }));
}

const { stats } = Astro.props as { stats: PlayerStats };
const { player, historial } = stats;
const figures = [
  { label: "Títulos", value: stats.titulos },
  { label: "Subcampeonatos", value: stats.subcampeonatos },
];

// Official category and position (ticket 07), as of the build date in Mendoza.
const hoy = new Intl.DateTimeFormat("en-CA", {
  timeZone: "America/Argentina/Mendoza",
}).format(new Date());
const anioActual = Number(hoy.slice(0, 4));
const official = buildOfficialProfile(
  player,
  await jsonArchivedTournamentRepository.list(),
  hoy
);
const POSICION_LABEL = { delantero: "Delantero", zaguero: "Zaguero" } as const;
const ORIGEN_LABEL = { federacion: "federación", ascenso: "ascenso" } as const;
const formatDate = (iso: string) => iso.split("-").reverse().join("/");
const pendiente = "Todavía no está cargada";
---

<Layout
  title={player.nombreOficial}
  description={`Estadísticas de ${player.nombreOficial} en los torneos finalizados.`}
>
  <Header />
  <main id="main-content">
    <section class="pt-12 pb-16 sm:pt-16">
      <p class="text-accent text-sm font-semibold tracking-[0.18em] uppercase">
        Jugador
      </p>
      <h1 class="mt-2 text-3xl font-bold sm:text-4xl">
        {player.nombreOficial}
      </h1>
      <p class="mt-3 text-base">
        Resultados de los torneos finalizados. El torneo en curso no se cuenta.
      </p>
      <dl class="mt-8 grid grid-cols-2 gap-4 sm:max-w-md">
        {
          figures.map(figure => (
            <div class="border-border rounded-xl border p-5">
              <dt class="text-lg font-semibold">{figure.label}</dt>
              <dd class="mt-2 text-4xl font-bold">{figure.value}</dd>
            </div>
          ))
        }
      </dl>

      <section class="mt-10" aria-labelledby="oficial-titulo">
        <h2 id="oficial-titulo" class="text-2xl font-bold">
          Categoría y posición
        </h2>
        <dl class="mt-4 grid gap-4 sm:max-w-md">
          <div class="border-border rounded-xl border p-5">
            <dt class="text-lg font-semibold">Categoría oficial</dt>
            <dd class="mt-2 text-2xl font-bold">
              {official.categoria?.categoria ?? pendiente}
            </dd>
          </div>
          <div class="border-border rounded-xl border p-5">
            <dt class="text-lg font-semibold">Posición {anioActual}</dt>
            <dd class="mt-2 text-2xl font-bold">
              {
                official.posicion
                  ? POSICION_LABEL[official.posicion.posicion]
                  : pendiente
              }
            </dd>
          </div>
        </dl>
        {
          official.posicionProvisoria && (
            <p
              class="border-accent mt-4 rounded-xl border-2 p-4 text-base sm:max-w-md"
              role="note"
            >
              <strong>Posición provisoria.</strong> La cargó la organización y
              todavía no es la lista oficial de la federación.
            </p>
          )
        }
        {
          official.cambios.length > 0 && (
            <div class="mt-6">
              <h3 class="text-xl font-semibold">
                Cambios de categoría en {anioActual}
              </h3>
              <ul class="mt-2 list-disc space-y-1 pl-6 text-base">
                {official.cambios.map(cambio => (
                  <li>
                    Desde el {formatDate(cambio.desde)}: de {cambio.anterior} a{" "}
                    {cambio.categoria} (por {ORIGEN_LABEL[cambio.origen]})
                  </li>
                ))}
              </ul>
            </div>
          )
        }
        <div class="mt-6">
          <h3 class="text-xl font-semibold">Títulos por posición</h3>
          {
            official.titulosPorPosicion.length > 0 ? (
              <ul class="mt-2 list-disc space-y-1 pl-6 text-base">
                {official.titulosPorPosicion.map(year => (
                  <li>
                    {year.anio}: {year.titulos}{" "}
                    {year.titulos === 1 ? "título" : "títulos"}
                    {year.posicion
                      ? ` como ${POSICION_LABEL[year.posicion].toLowerCase()}${year.provisoria ? " (posición provisoria)" : ""}`
                      : " (posición sin cargar)"}
                  </li>
                ))}
              </ul>
            ) : (
              <p class="mt-2 text-base">Sin títulos todavía.</p>
            )
          }
        </div>
      </section>
    </section>
    <section aria-labelledby="historial-titulo" class="pb-16">
      <h2 id="historial-titulo" class="text-2xl font-bold sm:text-3xl">
        Historial completo
      </h2>
      {
        historial.porAnio.length === 0 ? (
          <p class="mt-3 text-lg">
            Todavía no tiene partidos en torneos finalizados.
          </p>
        ) : (
          <div class="mt-6 grid gap-5 sm:max-w-xl">
            <RecordFiguresList
              title="Total de todos los torneos"
              figuras={historial.total}
              headingLevel={3}
            />
          </div>
        )
      }
      {
        historial.porAnio.map(year => (
          <div class="mt-10">
            <h3 class="text-2xl font-bold">Año {year.anio}</h3>
            <div class="mt-4 grid gap-5 sm:max-w-xl">
              {year.porCategoria.length > 1 && (
                <RecordFiguresList
                  title={`Total del año ${year.anio}`}
                  figuras={year.total}
                />
              )}
              {year.porCategoria.map(record => (
                <RecordFiguresList
                  title={`${year.anio} · Categoría ${record.categoria}`}
                  figuras={record.figuras}
                />
              ))}
            </div>
          </div>
        ))
      }
      {
        historial.porAnio.length > 1 && (
          <div class="mt-10">
            <h3 class="text-2xl font-bold">
              Por categoría, todos los años juntos
            </h3>
            <div class="mt-4 grid gap-5 sm:max-w-xl">
              {historial.porCategoria.map(record => (
                <RecordFiguresList
                  title={`Categoría ${record.categoria}`}
                  figuras={record.figuras}
                />
              ))}
            </div>
          </div>
        )
      }
    </section>
  </main>
  <Footer />
</Layout>
