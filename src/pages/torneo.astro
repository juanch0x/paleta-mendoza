---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ActiveTournament from "@/components/tournament/ActiveTournament";
import { activeTournamentConfig } from "@/data/active-tournament-config";

const title = "Torneo activo";
const parejasUrl = import.meta.env.PUBLIC_ACTIVE_TOURNAMENT_PAREJAS_CSV_URL;
const partidosUrl = import.meta.env.PUBLIC_ACTIVE_TOURNAMENT_PARTIDOS_CSV_URL;
const showMock = import.meta.env.DEV || import.meta.env.PUBLIC_TOURNAMENT_MOCK === "true";
---

<Layout title={title} description="Fixture, tablas y resultados del torneo activo.">
  <Header />
  <main id="main-content">
    <section class="pt-8 pb-12 sm:pt-12 sm:pb-16">
      <div class="rounded-xl border border-skin-line border-l-4 border-l-accent bg-skin-fill p-5 sm:p-6">
        <div class="flex items-center gap-2 text-sm font-semibold tracking-[0.2em] text-accent uppercase">
          <span class="relative flex size-2" aria-hidden="true">
            <span class="absolute inline-flex size-full animate-ping rounded-full bg-accent opacity-60"></span>
            <span class="relative inline-flex size-2 rounded-full bg-accent"></span>
          </span>
          Torneo activo
        </div>
        <h1 class="mt-3 max-w-2xl text-xl leading-tight font-bold sm:text-2xl">
          {activeTournamentConfig.name}
        </h1>
        <p class="mt-3 max-w-xl leading-7 text-skin-base/80">
          {activeTournamentConfig.description}
        </p>
      </div>
      <ActiveTournament
        client:only="react"
        parejasUrl={parejasUrl}
        partidosUrl={partidosUrl}
        showMock={showMock}
      />
    </section>
  </main>
  <Footer />
</Layout>
