---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ActiveTournament from "@/components/tournament/ActiveTournament";

const title = "Torneo activo";
const parejasUrl = import.meta.env.PUBLIC_ACTIVE_TOURNAMENT_PAREJAS_CSV_URL;
const partidosUrl = import.meta.env.PUBLIC_ACTIVE_TOURNAMENT_PARTIDOS_CSV_URL;
const showMock = import.meta.env.DEV || import.meta.env.PUBLIC_TOURNAMENT_MOCK === "true";
---

<Layout title={title} description="Fixture, tablas y resultados del torneo activo.">
  <Header />
  <main id="main-content">
    <section class="pt-12 pb-16 sm:pt-16">
      <p class="text-sm font-semibold tracking-[0.2em] text-accent uppercase">
        Torneo activo
      </p>
      <h1 class="mt-3 max-w-3xl text-4xl leading-tight font-bold sm:text-6xl">
        Fixture, resultados y posiciones.
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-8 text-foreground/80">
        Toda la información del torneo en curso, ordenada para consultar rápido desde el club.
      </p>
      <ActiveTournament
        client:only="react"
        parejasUrl={parejasUrl}
        partidosUrl={partidosUrl}
        showMock={showMock}
      />
    </section>
  </main>
  <Footer />
</Layout>
