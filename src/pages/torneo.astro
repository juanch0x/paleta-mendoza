---
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import ActiveTournament from "@/components/tournament/ActiveTournament";
import { activeTournamentConfig } from "@/data/active-tournament-config";

const title = "Torneo activo";
const parejasUrl = import.meta.env.PUBLIC_ACTIVE_TOURNAMENT_PAREJAS_CSV_URL;
const partidosUrl = import.meta.env.PUBLIC_ACTIVE_TOURNAMENT_PARTIDOS_CSV_URL;
const showMock = import.meta.env.DEV || import.meta.env.PUBLIC_TOURNAMENT_MOCK === "true";
---

<Layout title={title} description="Fixture, tablas y resultados del torneo activo.">
  <Header />
  <main id="main-content">
    <section class="pt-8 pb-12 sm:pt-12 sm:pb-16">
      <h1 class="sr-only">{activeTournamentConfig.name}</h1>
      <ActiveTournament
        client:only="react"
        parejasUrl={parejasUrl}
        partidosUrl={partidosUrl}
        showMock={showMock}
      />
    </section>
  </main>
  <Footer />
</Layout>
