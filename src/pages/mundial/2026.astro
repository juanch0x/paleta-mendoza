---
import Footer from "@/components/Footer.astro";
import Header from "@/components/Header.astro";
import MundialAgenda from "@/components/mundial/MundialAgenda";
import { mundial } from "@/data/mundial/agenda";
import Layout from "@/layouts/Layout.astro";
---

<Layout
  title={`${mundial.name} · Agenda 2026`}
  description="Agenda diaria del Mundial de Pelota Vasca 2026. Horarios, modalidades y participaciones confirmadas de Argentina."
>
  <Header />
  <main id="main-content">
    <section class="pt-8 pb-12 sm:pt-12 sm:pb-16">
      <header class="mt-8">
        <p
          class="text-accent text-xs font-semibold tracking-[0.18em] uppercase"
        >
          Mundial 2026
        </p>
        <h1 class="mt-3 text-xl font-bold sm:text-2xl">{mundial.name}</h1>
        <p class="text-foreground/75 mt-2 text-sm">
          15 al 24 de octubre de 2026
        </p>
        <p class="text-foreground/75 mt-2 text-xs leading-5">
          Horarios locales de Buenos Aires y Colonia (UTC−3).
        </p>
      </header>
      <MundialAgenda client:only="react">
        <p slot="fallback" class="mt-8 text-sm">Cargando agenda…</p>
      </MundialAgenda>
      <noscript
        ><p class="mt-4">
          Activá JavaScript para consultar la agenda diaria o <a
            class="text-accent underline"
            href={mundial.source.url}>descargá el programa original (PDF)</a
          >.
        </p></noscript
      >
    </section>
  </main>
  <Footer />
</Layout>
