PUBLIC_ACTIVE_TOURNAMENT_PAREJAS_CSV_URL=
PUBLIC_ACTIVE_TOURNAMENT_PARTIDOS_CSV_URL=
# Optional. Published `estado` sheet with demora_minutos, mensaje_importante, actualizado_en.
PUBLIC_ACTIVE_TOURNAMENT_STATUS_CSV_URL=

# Server-side Google Sheets diagnostics. Never prefix these with PUBLIC_.
GOOGLE_SHEETS_API_KEY=
# Required. The ID between /d/ and /edit in the Google Sheets URL.
GOOGLE_SHEETS_SPREADSHEET_ID=
# Required in production. The diagnostics page submits it via an Authorization header.
TOURNAMENT_DIAGNOSTICS_TOKEN=
